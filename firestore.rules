rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function userExistsAfter(userId) {
      return existsAfter(
        /databases/$(database)/documents/users/$(userId)
      );
    }

    function userAfter(userId) {
      return getAfter(/databases/$(database)/documents/users/$(userId));
    }

    function hasValidUserKeys() {
      return request.resource.data.keys().hasAll([
        'uid', 'id', 'authUid', 'canAuthenticate', 'name', 'fullName',
        'normalizedName', 'email', 'role', 'roles', 'accountStatus', 'cpf',
        'cpfDigits', 'cpfFormatted', 'guardianIds', 'dependentIds',
        'managedByUserIds', 'birthDate', 'phone', 'photoUrl', 'createdAt',
        'updatedAt', 'lastLoginAt'
      ]) && request.resource.data.keys().hasOnly([
        'uid', 'id', 'authUid', 'canAuthenticate', 'name', 'fullName',
        'normalizedName', 'email', 'role', 'roles', 'accountStatus', 'cpf',
        'cpfDigits', 'cpfFormatted', 'guardianIds', 'dependentIds',
        'managedByUserIds', 'relationshipToGuardian', 'birthDate', 'phone',
        'photoUrl', 'createdAt', 'updatedAt', 'lastLoginAt'
      ]);
    }

    function hasValidUserTypes() {
      return request.resource.data.uid is string
        && request.resource.data.id is string
        && request.resource.data.authUid is string
        && request.resource.data.canAuthenticate is bool
        && request.resource.data.name is string
        && request.resource.data.fullName is string
        && request.resource.data.normalizedName is string
        && request.resource.data.email is string
        && request.resource.data.role is string
        && request.resource.data.roles is list
        && request.resource.data.accountStatus is string
        && request.resource.data.cpf is string
        && request.resource.data.cpf.size() == 11
        && request.resource.data.cpfDigits is string
        && request.resource.data.cpfDigits == request.resource.data.cpf
        && request.resource.data.cpfFormatted is string
        && request.resource.data.guardianIds is list
        && request.resource.data.dependentIds is list
        && request.resource.data.managedByUserIds is list
        && (!request.resource.data.keys().hasAny(['relationshipToGuardian'])
          || request.resource.data.relationshipToGuardian == null
          || request.resource.data.relationshipToGuardian is string)
        && (request.resource.data.birthDate == null
          || request.resource.data.birthDate is timestamp)
        && (request.resource.data.phone == null
          || request.resource.data.phone is string)
        && (request.resource.data.photoUrl == null
          || request.resource.data.photoUrl is string)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (request.resource.data.lastLoginAt == null
          || request.resource.data.lastLoginAt is timestamp);
    }

    function validUserCreation(userId) {
      return isOwner(userId)
        && hasValidUserKeys()
        && hasValidUserTypes()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.id == request.auth.uid
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.canAuthenticate == true
        && request.resource.data.role == 'responsible'
        && request.resource.data.roles == ['user']
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.cpf.size() == 11
        && request.resource.data.guardianIds.size() == 0
        && request.resource.data.dependentIds.size() == 0
        && request.resource.data.managedByUserIds.size() == 0;
    }

    function validDependentCreation(userId) {
      return signedIn()
        && hasValidUserKeys()
        && hasValidUserTypes()
        && request.resource.data.uid == userId
        && request.resource.data.id == userId
        && request.resource.data.authUid == ''
        && request.resource.data.canAuthenticate == false
        && request.resource.data.email == ''
        && request.resource.data.role == 'dependent'
        && request.resource.data.roles == ['dependent']
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.guardianIds == [request.auth.uid]
        && request.resource.data.dependentIds.size() == 0
        && request.resource.data.managedByUserIds == [request.auth.uid]
        && request.resource.data.relationshipToGuardian is string
        && request.resource.data.relationshipToGuardian.size() > 0
        && userExistsAfter(request.auth.uid)
        && userAfter(request.auth.uid).data.dependentIds.hasAny([userId]);
    }

    function immutableUserFields() {
      return request.resource.data.uid == resource.data.uid
        && request.resource.data.id == resource.data.id
        && request.resource.data.authUid == resource.data.authUid
        && request.resource.data.canAuthenticate == resource.data.canAuthenticate
        && request.resource.data.email == resource.data.email
        && request.resource.data.role == resource.data.role
        && request.resource.data.roles == resource.data.roles
        && request.resource.data.accountStatus == resource.data.accountStatus
        && request.resource.data.cpf == resource.data.cpf
        && request.resource.data.cpfDigits == resource.data.cpfDigits
        && request.resource.data.cpfFormatted == resource.data.cpfFormatted
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.guardianIds == resource.data.guardianIds
        && request.resource.data.dependentIds == resource.data.dependentIds
        && request.resource.data.managedByUserIds == resource.data.managedByUserIds;
    }

    function onlyAllowedUserChanges() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'fullName', 'normalizedName', 'birthDate', 'phone', 'photoUrl',
        'updatedAt', 'lastLoginAt'
      ]);
    }

    function validDependentLinkUpdate(userId) {
      return isOwner(userId)
        && hasValidUserKeys()
        && hasValidUserTypes()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'dependentIds', 'updatedAt'
        ])
        && request.resource.data.dependentIds.size()
          == resource.data.dependentIds.size() + 1
        && request.resource.data.dependentIds.hasAll(resource.data.dependentIds)
        && !resource.data.dependentIds.hasAny([
          request.resource.data.dependentIds[
            request.resource.data.dependentIds.size() - 1
          ]
        ])
        && request.resource.data.dependentIds.toSet()
          .difference(resource.data.dependentIds.toSet()).hasOnly([
            request.resource.data.dependentIds[
              request.resource.data.dependentIds.size() - 1
            ]
          ])
        && userExistsAfter(
          request.resource.data.dependentIds[
            request.resource.data.dependentIds.size() - 1
          ]
        )
        && userAfter(
          request.resource.data.dependentIds[
            request.resource.data.dependentIds.size() - 1
          ]
        ).data.guardianIds == [request.auth.uid]
        && userAfter(
          request.resource.data.dependentIds[
            request.resource.data.dependentIds.size() - 1
          ]
        ).data.managedByUserIds == [request.auth.uid];
    }

    match /users/{userId} {
      allow create: if validUserCreation(userId) || validDependentCreation(userId);
      allow get: if isOwner(userId)
        || (signedIn() && resource.data.managedByUserIds.hasAny([request.auth.uid]));
      allow list: if false;
      allow update: if (isOwner(userId)
          && hasValidUserKeys()
          && hasValidUserTypes()
          && immutableUserFields()
          && onlyAllowedUserChanges())
        || validDependentLinkUpdate(userId);
      allow delete: if false;

      match /devices/{deviceId} {
        allow read, create, update, delete: if isOwner(userId);
      }
    }

    match /cpf_registry/{cpfHash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && cpfHash.size() == 64
        && request.resource.data.ownerUid is string
        && request.resource.data.createdAt is timestamp
        && ((request.resource.data.keys().hasAll(['ownerUid', 'createdAt'])
            && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt'])
            && request.resource.data.ownerUid == request.auth.uid)
          || (request.resource.data.keys().hasAll([
                'ownerUid', 'guardianUid', 'createdAt'
              ])
            && request.resource.data.keys().hasOnly([
                'ownerUid', 'guardianUid', 'createdAt'
            ])
            && request.resource.data.guardianUid == request.auth.uid
            && userExistsAfter(request.resource.data.ownerUid)
            && userAfter(request.resource.data.ownerUid).data.guardianIds
              == [request.auth.uid]
            && userAfter(request.resource.data.ownerUid).data.managedByUserIds
              == [request.auth.uid]));
      allow update, delete: if false;
    }

    // Coleções legítimas já consumidas pelas telas existentes.
    match /children/{childId} {
      allow create: if signedIn()
        && request.resource.data.responsibleId == request.auth.uid;
      allow read, update, delete: if signedIn()
        && resource.data.responsibleId == request.auth.uid;
    }

    match /vaccination_records/{recordId} {
      allow read: if signedIn()
        && resource.data.responsibleId == request.auth.uid;
      allow write: if false;
    }

    match /vaccines/{vaccineId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /vaccination_schedules/{scheduleId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /information_posts/{postId} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
